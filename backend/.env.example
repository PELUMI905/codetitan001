# Copy this file to .env and change these values before deployment.
CODETITAN_SECRET_KEY=replace-with-a-long-random-secret
TOKEN_HOURS=24
# Optional: setting both values creates/promotes an administrator at startup.
# ADMIN_NAME=CodeTitan Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Optional database path. Defaults to backend/data/codetitan_travel.db
# DATABASE_PATH=./data/codetitan_travel.db
